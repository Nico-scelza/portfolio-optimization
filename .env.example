# Server-side technical provider configuration for portfolio_optimization.
# Copy this file to `.env` locally (never commit `.env`) or export in your
# server environment. Never expose provider keys to client browsers.

# Optional Federal Reserve Economic Data (FRED) API key used solely as fallback
# for the annual USD risk-free rate (DGS10) if ^TNX is unavailable.
FRED_API_KEY=REPLACE_WITH_FRED_API_KEY
