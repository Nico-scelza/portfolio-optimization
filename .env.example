# Server-side API configuration for portfolio_optimization.
# Copy this file to `.env` locally (never commit `.env`) or set these variables
# in your server/runtime environment.

# Comma-separated Alpha Vantage API keys. Rotation preserves the exact list order.
ALPHA_VANTAGE_API_KEYS=REPLACE_WITH_ALPHA_VANTAGE_KEY_1,REPLACE_WITH_ALPHA_VANTAGE_KEY_2

# Google Gemini API key (reserved configuration slot migrated from the source notebook).
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY

# Federal Reserve Economic Data (FRED) API key.
FRED_API_KEY=REPLACE_WITH_FRED_API_KEY
